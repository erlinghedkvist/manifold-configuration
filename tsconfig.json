{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "cloud.ts",
    "cluster.ts",
    "layoutslib/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
